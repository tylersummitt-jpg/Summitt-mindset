# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local schema dumps from scripts/capture-baseline-schema.sh (do not commit)
.tmp/

# env files (can opt-in for committing if needed)
.env*

# clerk (local dev / keyless — never commit; may contain secrets)
.clerk/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

