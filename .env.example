# Meta Pixel (optional — numeric ID only)
NEXT_PUBLIC_META_PIXEL_ID=
# Set to false to disable pixel when ID is set (local/preview)
NEXT_PUBLIC_META_PIXEL_ENABLED=
# Meta Conversions API (server-only — never NEXT_PUBLIC_)
META_CAPI_ACCESS_TOKEN=
# Optional. Meta Test Events code. Ignored when VERCEL_ENV=production.
# Preview/local only. Never NEXT_PUBLIC_.
META_CAPI_TEST_EVENT_CODE=
# Acquisition funnel. The settings row stays off until Tyler turns it on.
# Instantly webhook custom header x-instantly-webhook-secret.
INSTANTLY_WEBHOOK_SECRET=
# Read-only Instantly API key for sender signals and a dry-run backfill.
INSTANTLY_API_KEY=
# Separate Resend webhook secret for warm acquisition mail. Not the recovery secret.
ACQUISITION_RESEND_WEBHOOK_SECRET=
